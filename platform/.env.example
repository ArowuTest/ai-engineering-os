DATABASE_URL=postgresql://engineering_os:engineering_os@localhost:55432/engineering_os_test
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=3100

# Real authentication is the default. Set true only for explicit local/test compatibility.
ALLOW_DEV_IDENTITY_HEADERS=false

# Optional first-owner bootstrap. Supply all four values together on an empty organisation.
BOOTSTRAP_ORGANISATION_ID=org-001
BOOTSTRAP_ORGANISATION_NAME=Development Organisation
BOOTSTRAP_OWNER_USER_ID=
BOOTSTRAP_OWNER_PASSWORD=

# Web server-side API connection. The active organisation is stored in an HTTP-only cookie after login.
API_BASE_URL=http://127.0.0.1:3100
DEV_ORGANISATION_ID=org-001

# Live Product Partner credentials remain server-side. Leave blank to disable a route.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
