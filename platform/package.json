{
  "name": "@engineering-os/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run .integration.test.ts --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc --noEmit --project tsconfig.base.json && npm run typecheck --workspace @engineering-os/web",
    "test:execution-environment": "vitest run packages/execution-environment/test --pool=forks --maxWorkers=1 --minWorkers=1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
